# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Доступ к OpenAI через ProxyAPI (Россия без VPN)
# Укажите API-ключ от https://proxyapi.ru (используется как OPENAI_API_KEY)
USE_PROXYAPI=true
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_API_KEY=

