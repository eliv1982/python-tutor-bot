# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI (используется официальный API OpenAI напрямую).
# ВСЕГДА обязателен, независимо от LLM_PROVIDER ниже: OpenAI по-прежнему
# нужен для embeddings, Vision, STT, TTS, генерации изображений и
# классификатора намерения "сгенерировать изображение".
OPENAI_API_KEY=

# Провайдер основного текстового диалога/RAG-ответов (Stage 2A).
# Допустимые значения: anthropic | openai. Некорректное значение = бот не
# запустится (fail closed), а не тихий откат к другому провайдеру.
# По умолчанию используется Anthropic Claude.
LLM_PROVIDER=anthropic

# Обязателен только если LLM_PROVIDER=anthropic (используется официальный
# API Anthropic напрямую).
ANTHROPIC_API_KEY=

# Опционально — модель Anthropic для основного диалога/RAG-ответов.
ANTHROPIC_MODEL=claude-sonnet-5

# Временный список доступа (Stage 1C, pre-auth hardening).
# Числовые Telegram user id (from_user.id), через запятую, кому разрешён
# доступ к боту. Узнать свой id можно, например, у @userinfobot.
# Пример формата (НЕ реальные id, замените на свои): 123456789,987654321
# ВАЖНО: пусто/не задано = доступ запрещён всем (fail closed) — бот не
# станет публичным сам по себе. Это временный механизм до будущей системы
# OAuth-логина. Внутренний UUID пользователя (см. DATABASE_URL ниже) уже
# существует начиная с этой стадии, но создаётся ТОЛЬКО после прохождения
# этой проверки — никогда как замена ей.
TELEGRAM_ALLOWED_USER_IDS=

# PostgreSQL (Stage 5C) — каноническая идентичность пользователей,
# привязка Telegram-аккаунтов, настройки (mode/voice), каталог владения
# документами. НЕ хранилище содержимого документов и НЕ история переписки.
# Строка подключения (диалект postgresql+psycopg://, драйвер psycopg v3 —
# один драйвер для sync и async доступа). Схема создаётся только через
# `alembic upgrade head`, приложение не создаёт таблицы само.
# Пример (замените на свои учётные данные):
DATABASE_URL=postgresql+psycopg://python_tutor:python_tutor@localhost:5432/python_tutor_bot

# Опционально
# BOT_MODE=text        — режим по умолчанию (не записывается в БД): text | voice | vision | rag
# DEFAULT_VOICE=alloy  — голос по умолчанию (не записывается в БД): alloy | echo | nova | fable | onyx | shimmer
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG   — подробное логирование (запросы, режимы, RAG, API)

# --- Web-адаптер (Stage 6A): FastAPI + серверные сессии -------------------
# Отдельная точка входа (web_main.py), не требуется для запуска Telegram-бота.

# Обязателен для web-адаптера (используется для подписи CSRF-токенов,
# см. web/csrf.py). Сгенерируйте случайное значение, например:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ВАЖНО: без значения (или короче 32 байт непробельных символов) web-адаптер
# не запустится (fail closed) — как и остальные обязательные секреты выше.
SESSION_SECRET_KEY=

# Окружение развёртывания web-адаптера: "production" (по умолчанию) или
# "development". В "production" WEB_COOKIE_SECURE=false ЗАПРЕЩЕНО (адаптер
# не запустится) — это защита от случайного продакшн-деплоя с отключённым
# Secure-флагом cookie. Установите development ТОЛЬКО для локальной
# разработки без HTTPS.
# WEB_ENV=production

# Secure-флаг для cookie сессии/CSRF (Set-Cookie: ...; Secure). По
# умолчанию true (безопасно для продакшна). Установите false ТОЛЬКО для
# локальной разработки без HTTPS (и только вместе с WEB_ENV=development —
# см. выше) — никогда в продакшне. Принимаются только явные булевы значения
# (true/false/1/0/yes/no, без учёта регистра); любое другое значение — это
# ошибка конфигурации (fail closed), а не молчаливое отключение Secure.
# WEB_COOKIE_SECURE=true

# Время жизни серверной сессии в секундах (без skользящего продления).
# По умолчанию 1209600 (14 дней). Должно быть положительным и не превышать
# 15552000 (180 дней).
# WEB_SESSION_TTL_SECONDS=1209600

# Хост/порт для локального запуска web_main.py (не используется тестами).
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# --- GitHub OAuth-логин (Stage 6B) -----------------------------------------
# Web-адаптер использует GitHub ТОЛЬКО для аутентификации: связывает
# стабильный числовой GitHub id (никогда не login/username — он может
# измениться — и никогда не email) с той же канонической моделью
# пользователя (users.id), что и Telegram. Токен доступа GitHub нигде не
# сохраняется — используется один раз, сразу после обмена кода, для запроса
# GET /user, и затем отбрасывается. Явное связывание Telegram- и
# GitHub-аккаунтов одного человека — Stage 6C, сознательно не реализовано
# здесь: первый вход через GitHub всегда создаёт СВОЙ отдельный канонический
# аккаунт, даже если тот же человек уже существует как Telegram-пользователь.
#
# Client ID/Secret создаются в настройках GitHub OAuth App
# (https://github.com/settings/developers). Используйте ОТДЕЛЬНОЕ
# OAuth-приложение для разработки и для продакшна — никогда общие учётные
# данные. Без значения (или с пробелами внутри) web-адаптер не запустится
# (fail closed) — GitHub-логин является обязательным маршрутом этого
# адаптера, а не опциональным флагом.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Callback URL — должен ТОЧНО совпадать со значением "Authorization callback
# URL", указанным в настройках GitHub OAuth App. В продакшне обязателен
# https://. Для локальной разработки допускается http:// ТОЛЬКО на
# буквальном loopback-хосте — 127.0.0.1 или ::1 (НЕ localhost — сознательно
# не принимается, см. github_oauth_config.py) — и ТОЛЬКО вместе с
# WEB_ENV=development (см. выше). URI не может содержать userinfo, fragment
# или query-параметры, и путь обязан быть ровно /api/auth/github/callback.
# Пример для локальной разработки только с backend (без фронтенда):
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
# С React-фронтендом (Stage 7B-1, `npm run dev` в frontend/) браузер работает
# через origin Vite (127.0.0.1:5173), который проксирует /api на backend —
# тогда callback указывает на Vite (и то же значение — в настройках dev
# OAuth App; нужны также WEB_ENV=development и WEB_COOKIE_SECURE=false):
# GITHUB_REDIRECT_URI=http://127.0.0.1:5173/api/auth/github/callback
GITHUB_REDIRECT_URI=

# Время жизни серверной OAuth-транзакции (state + PKCE) в секундах — по
# умолчанию 600 (10 минут). Должно быть положительным и не превышать 900
# (15 минут): транзакция обязана оставаться короткоживущей.
# GITHUB_OAUTH_TRANSACTION_TTL_SECONDS=600

# Database-authoritative admission control для GET /api/auth/github/login
# (Stage 6B corrective pass #1) — ограничивает неаутентифицированный рост
# github_oauth_transactions. Оба значения — положительные целые,
# fail closed при некорректном/неположительном значении.
# Максимум стартов логина за фиксированное 60-секундное окно, ГЛОБАЛЬНО
# (не по IP — надёжного контракта на IP клиента за прокси пока нет):
# GITHUB_OAUTH_MAX_STARTS_PER_MINUTE=30
# Жёсткий потолок одновременно живых (не просроченных, не заявленных)
# OAuth-транзакций — физическая граница размера таблицы:
# GITHUB_OAUTH_MAX_OUTSTANDING_TRANSACTIONS=200

# --- Связывание Telegram/GitHub-аккаунтов (Stage 6C) -----------------------
# Позволяет уже вошедшему через GitHub web-пользователю явно связать свой
# аккаунт с существующим Telegram-аккаунтом того же человека — канонический
# пользователь после связывания один (Telegram-сторона переживает связывание
# всегда). См. README.md, раздел "Связывание Telegram- и GitHub-аккаунтов".

# Имя Telegram-бота для диплинка (https://t.me/<имя>?start=link_<секрет>).
# Необязательный leading "@" нормализуется. В ОТЛИЧИЕ от остальных
# обязательных креденшлов адаптера: отсутствие/некорректное значение НЕ
# останавливает запуск web-адаптера и не ломает GitHub-логин/`/api/me`/
# logout — только POST /api/link/telegram/start в этом случае отвечает
# общим HTTP 503. Никогда не требует и не импортирует TELEGRAM_BOT_TOKEN.
# TELEGRAM_BOT_USERNAME=my_tutor_bot

# Время жизни одной попытки связывания (bearer-секрета) в секундах — по
# умолчанию 600 (10 минут). Должно быть положительным и не превышать 900
# (15 минут): секрет обязан оставаться короткоживущим.
# TELEGRAM_LINK_ATTEMPT_TTL_SECONDS=600
