data/generated_images/
data/documents/*
!data/documents/.gitkeep
# Version-controlled reference knowledge base (Stage 2B): these ARE part
# of the product and must be tracked. Managed Telegram uploads
# (data/documents/uploads/, including their .meta.json sidecars) stay
# gitignored via the blanket data/documents/* rule above — this negation
# only re-includes plain files directly under data/documents/.
!data/documents/*.md
data/*.mp3
data/*.ogg
data/*.wav
data/*.png
*.ogg
*.wav
*.mp3

# Frontend (Stage 7B-1): dependencies and generated build output — never
# committed. frontend/package-lock.json IS tracked (reproducible `npm ci`).
node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
npm-debug.log*

# Logs
*.log

# OS
.DS_Store
Thumbs.db

